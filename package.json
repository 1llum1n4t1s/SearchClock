{
  "name": "search-clock",
  "version": "1.0.13",
  "type": "commonjs",
  "packageManager": "bun@1.4.4",
  "description": "Chrome extension to fix Google search time period filters",
  "scripts": {
    "deps": "bun scripts/Install-Dependencies.mjs",
    "test": "bun test src/shared/presets.test.js src/background/background.test.js src/content/content.test.mjs",
    "check-domains": "bun scripts/check-domains.js",
    "generate-icons": "bun scripts/generate-icons.js",
    "generate-screenshots": "bun webstore/generate-screenshots.js",
    "build": "bun --bun run check-domains && bun --bun run generate-icons && bun --bun run generate-screenshots"
  },
  "devDependencies": {
    "puppeteer": "^25.16.0",
    "sharp": "^0.35.5"
  },
  "keywords": [
    "chrome-extension",
    "google-search",
    "time-filter",
    "search-clock"
  ],
  "author": "ゆろち",
  "license": "MIT",
  "trustedDependencies": [
    "sharp",
    "puppeteer"
  ]
}
