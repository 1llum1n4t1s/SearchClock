{
  "name": "search-clock",
  "version": "1.0.12",
  "type": "commonjs",
  "description": "Chrome extension to fix Google search time period filters",
  "scripts": {
    "test": "node --test src/shared/presets.test.js src/background/background.test.js src/content/content.test.mjs",
    "check-domains": "node scripts/check-domains.js",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-screenshots": "node webstore/generate-screenshots.js",
    "build": "pnpm run check-domains && pnpm run generate-icons && pnpm run generate-screenshots"
  },
  "devDependencies": {
    "chrome-webstore-upload-cli": "4.0.2",
    "puppeteer": "^25.16.0",
    "sharp": "^0.35.5"
  },
  "keywords": [
    "chrome-extension",
    "google-search",
    "time-filter",
    "search-clock"
  ],
  "author": "ゆろち",
  "license": "MIT"
}
